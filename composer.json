{
    "name": "basilicom/pimcore-plugin-system-banner",
    "description": "Shows a banner of the pimcore environment, to indicate if you are on prod or dev or else.",
    "type": "pimcore-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Kerstin Gerull",
            "email": "kerstin.gerull@basilicom.de"
        },
        {
            "name": "Fabian Fischer",
            "email": "fabian.fischer@basilicom.de"
        },
        {
            "name": "Alexander Heidrich",
            "email": "alexander.heidrich@basilicom.de"
        },
        {
            "name": "Marco Senkpiel",
            "email": "marco.senkpiel@basilicom.de"
        }
    ],
    "autoload": {
        "psr-4": {
            "Basilicom\\PimcorePluginSystemBanner\\": "src/"
        }
    },
    "require": {
        "php": ">=8.1",
        "pimcore/pimcore": "^11.0 || ^12.0 || ^2026.1"
    },
    "suggest": {
        "pimcore/studio-ui-bundle": "Required to show the banner in the Pimcore Studio UI (^2025.4 on Pimcore 12, ^2026.1 on Pimcore 2026)"
    }
}
